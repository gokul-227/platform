{
  "name": "@aec-craft/platform-mcp-tools",
  "version": "0.0.0",
  "description": "MCP tool descriptors and manifest helpers for the /mcp endpoint on apps/api. Imports wire shapes from @aec-craft/platform-contracts.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aec-craft/platform.git",
    "directory": "packages/mcp-tools"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo coverage",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ultracite check",
    "format": "ultracite fix"
  },
  "dependencies": {
    "@aec-craft/platform-contracts": "workspace:*",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
