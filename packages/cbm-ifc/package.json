{
  "name": "@aec-craft/platform-cbm-ifc",
  "version": "0.1.2",
  "description": "IFC as a cognitive building model. One folder per IFC mechanism, each documenting what IFC states, what we make of it, and what we deliberately drop. Semantics only: entities, relationships, properties and units. Geometry is somebody else's job.",
  "license": "UNLICENSED",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./read": {
      "import": {
        "types": "./dist/read.d.ts",
        "default": "./dist/read.js"
      },
      "require": {
        "types": "./dist/read.d.cts",
        "default": "./dist/read.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo coverage",
    "coverage": "tsup && node scripts/coverage.mjs",
    "dev": "tsup --watch",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "test": "vitest run"
  },
  "dependencies": {
    "@aec-craft/platform-cbm-engine": "workspace:*",
    "@aec-craft/platform-contracts": "workspace:*"
  },
  "peerDependencies": {
    "web-ifc": "0.0.77"
  },
  "peerDependenciesMeta": {
    "web-ifc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-ifc": "0.0.77"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aec-craft/platform.git",
    "directory": "packages/cbm-ifc"
  }
}
