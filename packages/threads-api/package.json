{
  "name": "@aec-craft/platform-threads-api",
  "version": "0.0.0",
  "description": "Threads API. Chat threads with an immutable message log and a managed generation-run lifecycle (LangGraph executor, HITL, SSE). Owns its slice of the platform database and its migrations. Embedded in the apps/api host.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "bin": {
    "threads-api-migrate": "./dist/bin/threads-api-migrate.cjs"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo coverage",
    "dev": "tsup --watch",
    "migrate": "tsx bin/threads-api-migrate.ts up",
    "migrate:status": "tsx bin/threads-api-migrate.ts status",
    "migrate:reconcile": "tsx bin/threads-api-migrate.ts reconcile",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "ultracite check",
    "format": "ultracite fix"
  },
  "peerDependencies": {
    "@aec-craft/platform-id-resource-nestjs": "^0.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@aec-craft/platform-authorization": "workspace:*",
    "@aec-craft/platform-common": "workspace:*",
    "@aec-craft/platform-contracts": "workspace:*",
    "@aec-craft/platform-metadata": "workspace:*",
    "@langchain/core": "^1.2.1",
    "@langchain/google-vertexai": "^2.2.0",
    "@langchain/langgraph": "^1.4.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.3",
    "@langchain/mcp-adapters": "^1.1.3",
    "drizzle-orm": "^0.44.0",
    "nestjs-zod": "^4.3.1",
    "pg": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aec-craft/platform-id-resource-nestjs": "^0.4.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
