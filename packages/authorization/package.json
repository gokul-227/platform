{
  "name": "@aec-craft/platform-authorization",
  "version": "0.0.0",
  "description": "The platform's authorization kernel. Owns the group tree and the Keto tuples that are the answer to every check, and exposes the decision surface (can / assertCan / assertCanAll / listReadableGroups, @RequirePermit, @CurrentGroup) every API package calls. Serves no routes and publishes no OpenAPI document; the group surface itself is tenancy-api's.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo coverage",
    "dev": "tsup --watch",
    "migrate": "tsx bin/authorization-migrate.ts up",
    "migrate:status": "tsx bin/authorization-migrate.ts status",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "backfill": "tsx bin/authorization-backfill.ts"
  },
  "peerDependencies": {
    "@aec-craft/platform-id-resource-nestjs": "^0.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@aec-craft/platform-common": "workspace:*",
    "@aec-craft/platform-contracts": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aec-craft/platform-id-resource-nestjs": "^0.4.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "authorization-migrate": "./dist/bin/authorization-migrate.cjs",
    "authorization-backfill": "./dist/bin/authorization-backfill.cjs"
  }
}
