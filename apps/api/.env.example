PORT=3100
DATABASE_URL=postgres://auth_app_role:dev@localhost:5433/platform

# Authorization store (Ory Keto). Required: every permission check and every
# retrieval scope resolves against it. Deployed envs are IAM-gated, which is
# what KETO_IDENTITY_TOKENS=true switches on; local Keto has no auth and is
# bound to loopback.
KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467
# KETO_IDENTITY_TOKENS=true

# The issuer whose access tokens this API accepts. One signature is verified
# against its published keys and the identity service is never called, so this is
# required and has no safe default of "any". The JWKS location is derived from it.
OIDC_ISSUER=http://localhost:4444

# The /docs portal's own client, registered in the console. Public client with
# PKCE and no secret, because Scalar runs in the browser. Unset renders the
# panel without a prefilled client.
DOCS_OIDC_CLIENT_ID=5fe2b8d1-6827-476d-b5d5-f37eb8040fef

# Public URL of this API, and its audience. Scalar sends it as the OAuth2
# `resource` indicator, the issuer stamps it into `aud`, and the guard requires
# it, so one value governs all three. It is also the `resource` this API
# publishes for RFC 9728 discovery and the challenge it puts on a 401, which is
# how an MCP client finds where to authenticate for /mcp.
PUBLIC_URL=http://localhost:3100

# Shared secret for the identity provider's back-channel: Kratos hooks that
# provision a profile after registration and settings changes, and the cascade
# delete. Must be identical to the value the identity estate sends, which it
# reads as IDENTITY_WEBHOOK_SECRET. Optional in local dev when the hook is not
# exercised; required in deployed envs. Generate with: openssl rand -base64 32.
# IDENTITY_WEBHOOK_SECRET=

# Comma-separated list of allowed origins, or `*` for any (what deployed envs
# set; auth is bearer-only, so no credential rides an origin). Unset disables
# CORS entirely rather than allowing anything.
# CORS_ORIGINS=*

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Optional. Shown in the OpenAPI doc and Scalar header.
# SERVICE_VERSION=dev
# SERVICE_COMMIT=
# SERVICE_BUILD_TIME=

# Optional. Set to "false" to disable /openapi + /docs in prod.
# API_DOCS_ENABLED=true

# Optional. Graph projection target. Unset = graph features dormant
# (POST /graph/query answers 503, version feed accumulates harmlessly). Local dev:
# `pnpm -C packages/platform-api db:graph:up` then uncomment the URI.
# GRAPH_DB_URI=bolt://localhost:7687
# GRAPH_DB_USERNAME=
# GRAPH_DB_PASSWORD=
# GRAPH_DB_ENGINE=memgraph
# GRAPH_SYNC_ENABLED=true

# Optional. File storage backend. Set a bucket name to enable file byte-ops;
# unset = create/upload/download answer 503 (folder ops still work). TF
# provisions the bucket + SA access in deployed envs.
# FILE_STORAGE_BUCKET=
# Origin the resumable session is opened for. Only needed against a bucket
# whose CORS restricts origins, and it holds one, so it cannot serve two
# browser apps; deployed envs leave it unset.
# FILE_UPLOAD_ORIGIN=http://localhost:3001
# Backend selection. Default gcs (signs with ADC). `s3` targets any
# S3-compatible service — AWS, MinIO, R2, B2, Supabase — and needs credentials;
# endpoint is for everything that is not AWS itself.
# FILE_STORAGE_PROVIDER=s3
# FILE_STORAGE_REGION=us-east-1
# FILE_STORAGE_ACCESS_KEY_ID=
# FILE_STORAGE_SECRET_ACCESS_KEY=
# FILE_STORAGE_ENDPOINT=http://localhost:9000

# Optional. Document index: uploads under the `document` preset become
# searchable by meaning and by term, and the chat can cite them.
# PINECONE_API_KEY is the switch: unset = files are stored and downloadable,
# and every index route answers 503. INDEX_HOST is the index's data-plane
# host; its dimension must equal RAG_DIMENSIONS.
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=docs-xxxxxxx.svc.aped-4627-b74a.pinecone.io
# The lexical half. Postgres full-text search by default — no extra service,
# same authorization predicate as a file listing. Set a sparse Pinecone index
# host to use that engine instead.
# PINECONE_SPARSE_INDEX_HOST=
# Embeddings and grounded answers: Gemini on Vertex via ADC, no key (same
# credential story as the run executor below). `ask` uses gemini-2.5-flash
# unless overridden; "none" disables `ask` while retrieval keeps working.
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=europe-west3
# RAG_DIMENSIONS=768
# VERTEX_ASK_MODEL=gemini-2.5-flash

# Optional. OCR: scanned PDFs, DOCX, PPTX and images become extractable, every
# PDF gains structured markdown with headings and tables, and the `document`
# preset admits the extra content types. Unset = only digital PDFs and plain
# text extract, and a scanned PDF fails ingestion loudly instead of indexing as
# empty.
#
# Two routes to Mistral's OCR model, and setting either one switches OCR on.
# VERTEX_OCR_LOCATION runs it through Vertex Model Garden: no key (ADC, as with
# the embedder), the pages processed in that region, and the usage billed
# through Google Cloud. The model has to be enabled per project on its model
# card first, and Model Garden serves it in few regions: us-central1 and
# europe-west4 answer, europe-west1 and the global endpoint 404. It takes
# precedence when both are set, because the request stays inside Google's network.
# VERTEX_OCR_LOCATION=europe-west4
#
# MISTRAL_API_KEY goes to Mistral's own API instead, which fetches each document
# by its signed URL, so the bytes leave this perimeter for their network. Enable
# that on purpose.
# MISTRAL_API_KEY=
# The model id, per route: mistral-ocr-latest direct, mistral-ocr-2505 on Vertex.
# MISTRAL_OCR_MODEL=
# The provider refuses requests past this many pages; longer documents are
# OCR'd in sequential page ranges of this size and reassembled. 30 is
# Mistral's cap today — raise it here when the provider raises theirs.
# MISTRAL_OCR_MAX_PAGES_PER_REQUEST=30

# Figure captions ride on OCR: extracted images become derived objects in the
# bucket, and a Gemini description of each is indexed, which is what makes
# drawings and site photos retrievable. Costs one model call per figure.
# On whenever OCR is on; "none" opts out while keeping OCR.
# VERTEX_CAPTION_MODEL=gemini-2.5-flash

# Optional. Managed run executor. Unset = the run worker stays dormant
# and thread runs sit `queued` (a client may finalize them itself); set
# LLM_ENABLED=true to have the platform generate replies. A run picks a tier
# (fast / standard / advanced); the tier→Gemini-model map is hardcoded in the
# executor (thread.run.worker.ts). Vertex is billed to the GCP project via ADC, no key (local:
# run `gcloud auth application-default login`; deployed: the Cloud Run SA needs
# roles/aiplatform.user).
# LLM_ENABLED=true
# GOOGLE_CLOUD_PROJECT=platform-dev-495017
# VERTEX_REGION=global

# Optional. Local/ops only. Persist each run's Cypher trace to thread_run.debug
# for the app's debug pill. Never enable in production (raw queries are not
# user-facing).
# DEBUG=true

# Every API slice shares DATABASE_URL above. Each migrator also honours a
# per-slice override (FILES_DATABASE_URL, THREADS_DATABASE_URL, ...) if a slice
# is ever split onto its own database; set the matching var for the app too.
