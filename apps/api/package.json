{
  "name": "@aec-craft/api",
  "version": "0.0.0",
  "description": "Platform API deployable. Binds every API package (directory, graph, files, threads, audit) into one host. Production-shaped: real JWT auth, CORS, helmet, compression, pino logs, rate limiting, health/version probes, Scalar docs.",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "clean": "rm -rf dist .tsbuildinfo coverage",
    "db:migrate": "dotenv -e .env -- sh -c 'authorization-migrate up && audit-api-migrate up && graph-api-migrate up && files-api-migrate up && threads-api-migrate up && authorization-backfill && tenancy-api-migrate up && users-api-migrate up'",
    "dev": "dotenv -e .env -- nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "db:backfill": "dotenv -e .env -- authorization-backfill",
    "graph:smoke": "node -r @swc-node/register scripts/graph.smoke.ts",
    "surface:smoke": "node -r @swc-node/register scripts/surface.smoke.ts"
  },
  "dependencies": {
    "@aec-craft/platform-admin-api": "workspace:*",
    "@aec-craft/platform-analysis-api": "workspace:*",
    "@aec-craft/platform-audit-api": "workspace:*",
    "@aec-craft/platform-authorization": "workspace:*",
    "@aec-craft/platform-common": "workspace:*",
    "@aec-craft/platform-contracts": "workspace:*",
    "@aec-craft/platform-files-api": "workspace:*",
    "@aec-craft/platform-graph-api": "workspace:*",
    "@aec-craft/platform-id-resource-nestjs": "^0.4.0",
    "@aec-craft/platform-mcp-tools": "workspace:*",
    "@aec-craft/platform-objects-api": "workspace:*",
    "@aec-craft/platform-tenancy-api": "workspace:*",
    "@aec-craft/platform-threads-api": "workspace:*",
    "@aec-craft/platform-users-api": "workspace:*",
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0",
    "@google-cloud/storage": "^7.14.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@scalar/nestjs-api-reference": "^1.1.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.44.0",
    "helmet": "^8.1.0",
    "nestjs-zod": "^4.3.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aec-craft/platform-admin-sdk": "workspace:*",
    "@aec-craft/platform-sdk": "workspace:*",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.41",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "neo4j-driver": "^6.1.0",
    "pg": "^8.16.3",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
