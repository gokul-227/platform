{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  // The base config excludes `*.test.ts` (it drives the emit build). Reset the
  // list here or the suites named in `include` are silently dropped.
  "exclude": ["dist", "node_modules"],
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"]
}
